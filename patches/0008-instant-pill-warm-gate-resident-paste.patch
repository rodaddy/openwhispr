-        if let config = try? JSONDecoder().decode(ListenerConfig.self, from: line) {
+        if line == Data("PASTE".utf8) {
+            postPasteKeystroke()
+        } else if let config = try? JSONDecoder().decode(ListenerConfig.self, from: line) {
             applyConfiguration(config)
