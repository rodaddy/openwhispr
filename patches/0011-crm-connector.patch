diff --git a/src/components/notes/CrmSyncDialog.tsx b/src/components/notes/CrmSyncDialog.tsx
new file mode 100644
index 00000000..01ea6a80
--- /dev/null
+++ b/src/components/notes/CrmSyncDialog.tsx
@@ -0,0 +1,301 @@
+import { useEffect, useMemo, useState } from "react";
+import { useTranslation } from "react-i18next";
+import { Building2, Contact, ExternalLink, Loader2, Plus, Search } from "lucide-react";
+import { Button } from "../ui/button";
+import { Badge } from "../ui/badge";
+import {
+  Dialog,
+  DialogContent,
+  DialogDescription,
+  DialogFooter,
+  DialogHeader,
+  DialogTitle,
+} from "../ui/dialog";
+import { Input } from "../ui/input";
+import type { NoteItem } from "../../types/electron";
+import type { CrmCreateContactInput, CrmSyncState, CrmTarget } from "../../types/crm";
+
+interface CrmSyncDialogProps {
+  open: boolean;
+  onOpenChange: (open: boolean) => void;
+  note: NoteItem;
+  initialState: CrmSyncState | null;
+  onBeforeSync: () => Promise<void>;
+  onSynced: (state: CrmSyncState) => void;
+}
+
+interface AttendeeSeed {
+  name: string;
+  email: string;
+}
+
+function firstAttendee(raw: string | null): AttendeeSeed | null {
+  if (!raw) return null;
+  try {
+    const rows = JSON.parse(raw);
+    if (!Array.isArray(rows)) return null;
+    const row = rows.find((item) => item && !item.self && (item.email || item.displayName));
+    if (!row) return null;
+    return { name: String(row.displayName || ""), email: String(row.email || "") };
+  } catch {
+    return null;
+  }
+}
+
+function domainFromEmail(email: string): string {
+  const domain = email.trim().toLowerCase().split("@")[1] || "";
+  return /^(gmail|googlemail|outlook|hotmail|icloud|yahoo|protonmail|proton)\./.test(domain)
+    ? ""
+    : domain;
+}
+
+export default function CrmSyncDialog({
+  open,
+  onOpenChange,
+  note,
+  initialState,
+  onBeforeSync,
+  onSynced,
+}: CrmSyncDialogProps) {
+  const { t } = useTranslation();
+  const attendee = useMemo(() => firstAttendee(note.participants), [note.participants]);
+  const initialQuery = attendee?.email || attendee?.name || note.title;
+  const [query, setQuery] = useState(initialQuery);
+  const [targets, setTargets] = useState<CrmTarget[]>([]);
+  const [selected, setSelected] = useState<CrmTarget | null>(null);
+  const [searching, setSearching] = useState(false);
+  const [showCreate, setShowCreate] = useState(false);
+  const [creating, setCreating] = useState(false);
+  const [syncing, setSyncing] = useState(false);
+  const [syncState, setSyncState] = useState(initialState);
+  const [error, setError] = useState("");
+  const [contact, setContact] = useState<CrmCreateContactInput>({
+    name: attendee?.name || "",
+    email: attendee?.email || "",
+    companyName: "",
+    companyDomain: domainFromEmail(attendee?.email || ""),
+  });
+
+  useEffect(() => {
+    if (!open) return;
+    setQuery(initialQuery);
+    setSelected(null);
+    setShowCreate(false);
+    setSyncState(initialState);
+    setTargets([]);
+    setSearching(false);
+    setError("");
+    setContact({
+      name: attendee?.name || "",
+      email: attendee?.email || "",
+      companyName: "",
+      companyDomain: domainFromEmail(attendee?.email || ""),
+    });
+  }, [attendee, initialQuery, initialState, open]);
+
+  useEffect(() => {
+    if (!open) return;
+    let cancelled = false;
+    setSelected(null);
+    setTargets([]);
+    const timer = setTimeout(async () => {
+      setSearching(true);
+      const result = await window.electronAPI.crmSearchTargets(query.trim());
+      if (cancelled) return;
+      if ("targets" in result) setTargets(result.targets);
+      else setError(result.error);
+      setSearching(false);
+    }, 250);
+    return () => {
+      cancelled = true;
+      clearTimeout(timer);
+    };
+  }, [open, query]);
+
+  const createContact = async () => {
+    if (!contact.name.trim() || !contact.email.trim()) return;
+    setCreating(true);
+    setError("");
+    const result = await window.electronAPI.crmCreateContact({
+      name: contact.name.trim(),
+      email: contact.email.trim(),
+      companyName: contact.companyName?.trim() || undefined,
+      // Empty is intentional: clearing the editable suggestion means no
+      // company association, including for an otherwise derivable domain.
+      companyDomain: contact.companyDomain?.trim() ?? "",
+    });
+    if ("target" in result) {
+      setSelected(result.target);
+      setTargets((rows) => [result.target, ...rows.filter((row) => row.id !== result.target.id)]);
+      setShowCreate(false);
+    } else setError(result.error);
+    setCreating(false);
+  };
+
+  const sync = async () => {
+    if (!selected) return;
+    setSyncing(true);
+    setError("");
+    try {
+      await onBeforeSync();
+      const result = await window.electronAPI.crmSyncNote(note.id, selected);
+      if ("state" in result) {
+        setSyncState(result.state);
+        onSynced(result.state);
+      } else setError(result.error);
+    } catch (cause) {
+      setError(cause instanceof Error ? cause.message : String(cause));
+    } finally {
+      setSyncing(false);
+    }
+  };
+
+  return (
+    <Dialog open={open} onOpenChange={onOpenChange}>
+      <DialogContent className="sm:max-w-xl">
+        <DialogHeader>
+          <DialogTitle>
+            {syncState
+              ? t("notes.crm.updateTitle", { defaultValue: "Update CRM note" })
+              : t("notes.crm.syncTitle", { defaultValue: "Sync note to CRM" })}
+          </DialogTitle>
+          <DialogDescription>
+            {t("notes.crm.description", {
+              defaultValue: "Choose one contact or company for this note.",
+            })}
+          </DialogDescription>
+        </DialogHeader>
+
+        {syncState && (
+          <div className="flex items-center justify-between rounded-lg border border-success/20 bg-success/5 px-3 py-2 text-xs">
+            <Badge variant="success">
