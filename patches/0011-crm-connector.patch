+        "/rest/contacts",
+        {
+          method: "POST",
+          body: { firstName, lastName, email, ...(companyId ? { companyId } : {}) },
+        },
+        config
+      );
+      if (!payload.id)
+        throw new CrmError("CRM returned an invalid contact", { code: "INVALID_RESPONSE" });
+      return {
+        id: String(payload.id),
+        type: "contact",
+        name: [payload.firstName, payload.lastName].filter(Boolean).join(" ") || name,
+        ...(payload.email || email ? { email: String(payload.email || email) } : {}),
+      };
+    },
+    syncNote(noteId, target) {
+      const key = String(noteId);
+      const prior = noteQueues.get(key) || Promise.resolve();
+      const next = prior.catch(() => {}).then(() => syncOnce(noteId, target));
+      noteQueues.set(key, next);
+      return next.finally(() => {
+        if (noteQueues.get(key) === next) noteQueues.delete(key);
