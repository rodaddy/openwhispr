+    return {
+      activityId,
+      targetId: state.targetId,
+      targetType: state.targetType,
+      syncedAt,
+      url: `${config.appUrl}/${encodeURIComponent(config.workspaceSlug)}/${target.type === "contact" ? "contacts" : "companies"}/${encodeURIComponent(target.id)}`,
+    };
+  }
+
+  return {
+    async getSettings() {
+      let settings;
+      try {
+        settings = sanitizeSettings(await store.getSettings());
+      } catch {
