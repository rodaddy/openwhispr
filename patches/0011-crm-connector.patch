+    async createContact(input) {
+      const name = String(input?.name || "").trim();
+      const email = String(input?.email || "").trim();
+      if (!name || !email)
+        throw new CrmError("Contact name and email are required", { code: "INVALID_CONTACT" });
+      const config = await resolvedConfig();
+      const existingContacts = await request(
+        "/rest/contacts/search",
+        {
+          method: "POST",
+          body: { q: email, page: 1, pageSize: 100 },
+        },
+        config
+      );
+      if (!Array.isArray(existingContacts.payload.rows)) {
+        throw new CrmError("CRM returned an invalid contact search", { code: "INVALID_RESPONSE" });
+      }
+      const existing = existingContacts.payload.rows.find(
+        (row) =>
+          String(row.email || "")
+            .trim()
+            .toLowerCase() === email.toLowerCase()
+      );
+      if (existing) {
+        return {
+          id: String(existing.id),
+          type: "contact",
+          name: [existing.firstName, existing.lastName].filter(Boolean).join(" ").trim() || name,
+          email: String(existing.email),
+        };
+      }
+      let companyId;
+      if (input.companyName && input.companyDomain !== "") {
+        const companyName = String(input.companyName).trim();
+        const domain = String(input.companyDomain || "")
+          .trim()
+          .toLowerCase();
+        const { payload } = await request(
+          "/rest/companies/search",
+          { method: "POST", body: { q: domain || companyName, page: 1, pageSize: 100 } },
+          config
+        );
+        if (!Array.isArray(payload.rows))
+          throw new CrmError("CRM returned an invalid company search", {
+            code: "INVALID_RESPONSE",
+          });
+        const match = payload.rows.find(
+          (row) => domain && String(row.domain || row.domainName || "").toLowerCase() === domain
+        );
+        if (match) companyId = String(match.id);
+        else {
+          const created = await request(
+            "/rest/companies",
+            { method: "POST", body: { name: companyName, ...(domain ? { domain } : {}) } },
+            config
+          );
+          if (!created.payload.id)
+            throw new CrmError("CRM returned an invalid company", { code: "INVALID_RESPONSE" });
+          companyId = String(created.payload.id);
+        }
