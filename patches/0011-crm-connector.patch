+export type CrmTargetType = "contact" | "company";
+
+export interface CrmTarget {
+  id: string;
+  type: CrmTargetType;
+  name: string;
+  email?: string;
+  domain?: string;
+}
+
+export interface CrmSettings {
+  baseUrl: string;
+  appUrl: string;
+  workspaceSlug: string;
+  hasApiKey?: boolean;
+  configured?: boolean;
+}
+
+export interface CrmSyncState {
+  activityId: string;
+  targetId: string;
+  targetType: CrmTargetType;
+  syncedAt: string;
+  url: string;
+}
+
+export interface CrmSaveSettingsInput {
+  baseUrl: string;
+  appUrl: string;
+  workspaceSlug: string;
+  apiKey?: string;
+}
+
+export interface CrmCreateContactInput {
+  name: string;
+  email: string;
+  companyName?: string;
+  companyDomain?: string;
+}
+
+export type CrmFailure = {
+  success: false;
+  error: string;
+  code?: string;
+  status?: number;
+};
+
+export type CrmSettingsResult = { success: true; settings: CrmSettings } | CrmFailure;
+export type CrmTestConnectionResult =
+  { success: true; status: number; rowCount: number } | CrmFailure;
+export type CrmSearchTargetsResult = { success: true; targets: CrmTarget[] } | CrmFailure;
+export type CrmCreateContactResult = { success: true; target: CrmTarget } | CrmFailure;
+export type CrmSyncResult = { success: true; state: CrmSyncState } | CrmFailure;
+export type CrmGetSyncStateResult = { success: true; state: CrmSyncState | null } | CrmFailure;
