diff --git a/scripts/check-crm-contract.js b/scripts/check-crm-contract.js
new file mode 100644
index 00000000..432fa372
--- /dev/null
+++ b/scripts/check-crm-contract.js
@@ -0,0 +1,69 @@
+#!/usr/bin/env node
+
+const baseUrl = process.argv[2];
+
+function usageError(message) {
+  console.error(message);
+  console.error("Usage: node scripts/check-crm-contract.js <http(s)://crm-base-url>");
+  process.exitCode = 2;
+}
+
+async function main() {
+  if (!baseUrl) return usageError("CRM base URL is required.");
+  let parsed;
+  try {
+    parsed = new URL(baseUrl);
+  } catch {
+    return usageError("CRM base URL is invalid.");
+  }
+  if (!["http:", "https:"].includes(parsed.protocol) || parsed.username || parsed.password) {
+    return usageError("CRM base URL must be HTTP(S) and must not contain credentials.");
+  }
+
+  const openapiUrl = new URL("/openapi.json", parsed).toString();
+  let response;
+  try {
+    response = await fetch(openapiUrl, { redirect: "error" });
+  } catch {
+    console.error(`Unable to read OpenAPI document from ${openapiUrl}.`);
+    process.exitCode = 1;
+    return;
+  }
+  if (!response.ok) {
+    console.error(`OpenAPI request failed with HTTP ${response.status}.`);
+    process.exitCode = 1;
+    return;
+  }
+
+  let document;
+  try {
+    document = await response.json();
+  } catch {
+    console.error("OpenAPI response is not valid JSON.");
+    process.exitCode = 1;
+    return;
+  }
+
+  const required = [
+    ["get", "/search"],
+    ["post", "/contacts/search"],
+    ["post", "/companies/search"],
+    ["post", "/contacts"],
+    ["post", "/companies"],
+    ["post", "/activities"],
+    ["patch", "/activities/{id}"],
+  ];
+  const missing = required.filter(([method, path]) => !document.paths?.[path]?.[method]);
+  if (missing.length) {
+    console.error("CRM OpenAPI contract is missing:");
+    for (const [method, path] of missing) console.error(`- ${method.toUpperCase()} /rest${path}`);
+    process.exitCode = 1;
+    return;
+  }
+  console.log("CRM OpenAPI contract includes all required operations.");
+}
+
+main().catch(() => {
+  console.error("CRM OpenAPI contract check failed.");
+  process.exitCode = 1;
+});
diff --git a/src/components/CrmIntegrationCard.tsx b/src/components/CrmIntegrationCard.tsx
new file mode 100644
index 00000000..a250e2af
--- /dev/null
+++ b/src/components/CrmIntegrationCard.tsx
@@ -0,0 +1,236 @@
+import { useCallback, useEffect, useState } from "react";
+import { useTranslation } from "react-i18next";
+import { CheckCircle2, KeyRound, Loader2, RefreshCw, Trash2 } from "lucide-react";
+import { Badge } from "./ui/badge";
+import { Button } from "./ui/button";
+import { Input } from "./ui/input";
+import type { CrmFailure, CrmSettings, CrmSaveSettingsInput } from "../types/crm";
+
+const EMPTY_SETTINGS: CrmSettings = {
+  baseUrl: "",
+  appUrl: "",
+  workspaceSlug: "",
+  hasApiKey: false,
+  configured: false,
+};
+
+function failureKind(error: CrmFailure): "auth" | "unreachable" | "generic" {
+  const code = error.code?.toLowerCase();
+  if (error.status === 401 || error.status === 403 || code?.includes("auth")) return "auth";
+  if (
+    code === "unreachable" ||
+    code === "network" ||
+    code === "network_error" ||
+    code === "timeout" ||
+    /unreachable|connect|network|fetch/i.test(error.error)
+  ) {
+    return "unreachable";
+  }
+  return "generic";
+}
+
+export default function CrmIntegrationCard() {
+  const { t } = useTranslation();
+  const [settings, setSettings] = useState(EMPTY_SETTINGS);
+  const [apiKey, setApiKey] = useState("");
+  const [loading, setLoading] = useState(true);
+  const [saving, setSaving] = useState(false);
+  const [testing, setTesting] = useState(false);
+  const [message, setMessage] = useState<{
+    kind: "success" | "auth" | "unreachable" | "generic";
+    text: string;
+  } | null>(null);
+
+  const load = useCallback(async () => {
+    setLoading(true);
+    const result = await window.electronAPI.crmGetSettings();
+    if ("settings" in result) {
+      const configured =
+        result.settings.configured ??
+        Boolean(
+          result.settings.baseUrl &&
+          result.settings.appUrl &&
+          result.settings.workspaceSlug &&
+          result.settings.hasApiKey
+        );
+      setSettings({ ...result.settings, configured });
+    } else setMessage({ kind: failureKind(result), text: result.error });
+    setLoading(false);
+  }, []);
+
+  useEffect(() => {
+    void load();
+  }, [load]);
+
+  const save = async (removeKey = false) => {
+    setSaving(true);
+    setMessage(null);
+    const input: CrmSaveSettingsInput = {
+      baseUrl: settings.baseUrl.trim(),
+      appUrl: settings.appUrl.trim(),
+      workspaceSlug: settings.workspaceSlug.trim(),
+    };
+    if (removeKey) input.apiKey = "";
+    else if (apiKey.trim()) input.apiKey = apiKey.trim();
+    const result = await window.electronAPI.crmSaveSettings(input);
+    if ("settings" in result) {
+      setSettings(result.settings);
+      setApiKey("");
+      setMessage({
+        kind: "success",
+        text: t("integrations.crm.saved", { defaultValue: "CRM settings saved" }),
+      });
+    } else {
+      setMessage({ kind: failureKind(result), text: result.error });
+    }
+    setSaving(false);
+  };
+
+  const test = async () => {
+    setTesting(true);
+    setMessage(null);
+    const result = await window.electronAPI.crmTestConnection();
+    if ("rowCount" in result) {
+      setMessage({
+        kind: "success",
+        text: t("integrations.crm.testSuccess", {
+          defaultValue: "Connected (HTTP {{status}}) · {{count}} CRM records available",
+          status: result.status,
+          count: result.rowCount,
+        }),
+      });
+    } else {
+      const kind = failureKind(result);
+      const fallback =
+        kind === "auth"
+          ? "Authentication failed. Check the API key."
+          : kind === "unreachable"
+            ? "CRM is unreachable. Check the server URL."
+            : result.error;
+      setMessage({ kind, text: t(`integrations.crm.${kind}Error`, { defaultValue: fallback }) });
+    }
+    setTesting(false);
+  };
+
+  if (loading) {
+    return (
+      <div className="rounded-lg border border-border/50 p-4">
+        <Loader2 className="h-4 w-4 animate-spin text-muted-foreground" />
+      </div>
+    );
+  }
+
+  return (
+    <div className="rounded-lg border border-border/50 dark:border-border-subtle/70 bg-card/50 dark:bg-surface-2/50 backdrop-blur-sm p-4">
+      <div className="flex items-start gap-3 mb-4">
+        <div className="w-9 h-9 rounded-lg bg-primary/5 dark:bg-primary/10 flex items-center justify-center shrink-0">
+          <KeyRound className="h-4 w-4 text-primary/80" />
+        </div>
+        <div className="min-w-0 flex-1">
+          <div className="flex items-center gap-2">
+            <h3 className="text-sm font-semibold text-foreground">
+              {t("integrations.crm.title", { defaultValue: "CRM" })}
+            </h3>
+            {settings.configured && (
+              <Badge variant="success">
+                {t("integrations.crm.configured", { defaultValue: "Configured" })}
+              </Badge>
+            )}
+          </div>
+          <p className="text-xs text-muted-foreground/70 mt-0.5 leading-relaxed">
+            {t("integrations.crm.description", {
+              defaultValue: "Sync saved notes to CRM contacts and companies.",
+            })}
+          </p>
+        </div>
+      </div>
+
+      <div className="grid gap-3 sm:grid-cols-2">
+        <label className="space-y-1 text-xs text-muted-foreground">
+          {t("integrations.crm.baseUrl", { defaultValue: "API base URL" })}
+          <Input
+            value={settings.baseUrl}
+            onChange={(e) => setSettings((s) => ({ ...s, baseUrl: e.target.value }))}
+            placeholder="https://crm-api.example.com"
+          />
+        </label>
+        <label className="space-y-1 text-xs text-muted-foreground">
+          {t("integrations.crm.appUrl", { defaultValue: "CRM app URL" })}
+          <Input
+            value={settings.appUrl}
+            onChange={(e) => setSettings((s) => ({ ...s, appUrl: e.target.value }))}
+            placeholder="https://crm.example.com"
+          />
+        </label>
+        <label className="space-y-1 text-xs text-muted-foreground">
+          {t("integrations.crm.workspace", { defaultValue: "Workspace slug" })}
+          <Input
+            value={settings.workspaceSlug}
+            onChange={(e) => setSettings((s) => ({ ...s, workspaceSlug: e.target.value }))}
+            placeholder="my-workspace"
+          />
+        </label>
+        <label className="space-y-1 text-xs text-muted-foreground">
+          {t("integrations.crm.apiKey", { defaultValue: "API key" })}
+          <Input
+            type="password"
+            value={apiKey}
+            onChange={(e) => setApiKey(e.target.value)}
+            placeholder={
+              settings.hasApiKey
+                ? t("integrations.crm.keyUnchanged", {
+                    defaultValue: "Saved · leave blank to keep",
+                  })
+                : ""
+            }
+            autoComplete="new-password"
+          />
+        </label>
+      </div>
+
+      {message && (
+        <div
+          className={`mt-3 text-xs ${message.kind === "success" ? "text-success" : message.kind === "auth" ? "text-destructive" : "text-warning"}`}
+        >
+          {message.text}
+        </div>
+      )}
+
+      <div className="flex flex-wrap items-center gap-2 mt-4">
+        <Button size="sm" onClick={() => void save()} disabled={saving || testing}>
+          {saving ? (
+            <Loader2 className="h-3.5 w-3.5 animate-spin" />
+          ) : (
+            <CheckCircle2 className="h-3.5 w-3.5" />
+          )}
+          {t("common.save", { defaultValue: "Save" })}
+        </Button>
+        <Button
+          size="sm"
+          variant="outline"
+          onClick={() => void test()}
+          disabled={saving || testing || !settings.configured}
+        >
+          {testing ? (
+            <Loader2 className="h-3.5 w-3.5 animate-spin" />
+          ) : (
+            <RefreshCw className="h-3.5 w-3.5" />
+          )}
+          {t("integrations.crm.test", { defaultValue: "Test connection" })}
+        </Button>
+        {settings.hasApiKey && (
+          <Button
+            size="sm"
+            variant="ghost"
+            onClick={() => void save(true)}
+            disabled={saving || testing}
+            className="text-destructive"
+          >
+            <Trash2 className="h-3.5 w-3.5" />
+            {t("integrations.crm.removeKey", { defaultValue: "Remove API key" })}
+          </Button>
+        )}
+      </div>
+    </div>
+  );
+}
