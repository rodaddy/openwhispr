+      return { status: 200, rowCount: payload.hits.length };
+    },
+    async searchTargets(query) {
+      const q = String(query || "").trim();
+      if (!q) return [];
+      const config = await resolvedConfig();
+      const searchBody = { q, page: 1, pageSize: 100 };
+      const [contacts, companies] = await Promise.all([
+        request("/rest/contacts/search", { method: "POST", body: searchBody }, config),
+        request("/rest/companies/search", { method: "POST", body: searchBody }, config),
+      ]);
+      if (!Array.isArray(contacts.payload.rows) || !Array.isArray(companies.payload.rows)) {
+        throw new CrmError("CRM returned an invalid search response", { code: "INVALID_RESPONSE" });
+      }
+      return [
+        ...contacts.payload.rows.flatMap((row) => {
+          if (!row?.id) return [];
+          const name = [row.firstName, row.lastName].filter(Boolean).join(" ").trim();
+          return name
+            ? [
+                {
+                  id: String(row.id),
+                  type: "contact",
+                  name,
+                  ...(row.email ? { email: String(row.email) } : {}),
+                },
+              ]
+            : [];
+        }),
+        ...companies.payload.rows.flatMap((row) =>
+          row?.id && row?.name
+            ? [
+                {
+                  id: String(row.id),
+                  type: "company",
+                  name: String(row.name),
+                  ...(row.domain ? { domain: String(row.domain) } : {}),
+                },
+              ]
+            : []
+        ),
