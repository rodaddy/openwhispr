diff --git a/src/helpers/crmConnector.js b/src/helpers/crmConnector.js
new file mode 100644
index 00000000..840eb8be
--- /dev/null
+++ b/src/helpers/crmConnector.js
@@ -0,0 +1,419 @@
+const crypto = require("crypto");
+const { parseNoteDate } = require("./transcriptFormatter");
+
+const REQUEST_TIMEOUT_MS = 10000;
+
+class CrmError extends Error {
+  constructor(message, { code, status } = {}) {
+    super(message);
+    this.name = "CrmError";
+    if (code) this.code = code;
+    if (status) this.status = status;
+  }
+}
+
+function normalizeUrl(value, field) {
+  let url;
+  try {
+    url = new URL(String(value || ""));
+  } catch {
+    throw new CrmError(`${field} must be a valid HTTP(S) URL`, { code: "INVALID_SETTINGS" });
+  }
+  if (
+    !["http:", "https:"].includes(url.protocol) ||
+    url.username ||
+    url.password ||
+    url.search ||
+    url.hash
+  ) {
+    throw new CrmError(
+      `${field} must be a valid HTTP(S) URL without credentials, query, or fragment`,
+      {
+        code: "INVALID_SETTINGS",
+      }
+    );
+  }
+  return url.toString().replace(/\/$/, "");
+}
+
+function sanitizeSettings(input = {}) {
+  const workspaceSlug = String(input.workspaceSlug || "").trim();
+  if (!workspaceSlug || !/^[A-Za-z0-9_-]+$/.test(workspaceSlug)) {
+    throw new CrmError("Workspace slug is invalid", { code: "INVALID_SETTINGS" });
+  }
+  return {
+    baseUrl: normalizeUrl(input.baseUrl, "CRM base URL"),
+    appUrl: normalizeUrl(input.appUrl, "CRM app URL"),
+    workspaceSlug,
+  };
+}
+
+function renderTranscript(note) {
+  const raw = note.transcript || note.content || "";
+  if (typeof raw !== "string") return String(raw || "");
+  try {
+    const parsed = JSON.parse(raw);
+    const segments = Array.isArray(parsed) ? parsed : parsed?.segments;
+    if (!Array.isArray(segments)) return raw;
+    const mappings = note.speakerMappings || {};
+    return segments
+      .filter((segment) => segment?.text?.trim())
+      .map((segment) => {
+        const speaker =
+          (segment.speakerName && !segment.speakerIsPlaceholder && segment.speakerName) ||
+          mappings[segment.speaker] ||
+          (segment.speaker === "you" || segment.source === "mic" ? "You" : null) ||
+          (segment.source === "system" ? "Others" : null) ||
+          (segment.speaker
+            ? `Speaker ${Number.parseInt(String(segment.speaker).replace("speaker_", ""), 10) + 1}`
+            : "Unknown Speaker");
+        return `${speaker}: ${segment.text.trim()}`;
+      })
+      .join("\n\n");
+  } catch {
+    return raw;
+  }
+}
+
+function buildActivityBody(note, timestamp) {
+  const summary = String(note.enhanced_content || note.content || "").trim();
+  const transcript = renderTranscript(note).trim();
+  const parts = [];
+  if (summary) parts.push(summary);
+  if (transcript && transcript !== summary) parts.push(transcript);
+  const noteId = note.id == null ? "unknown" : note.id;
+  parts.push(`Synced from OpenWhispr ${noteId} on ${timestamp.toISOString()}`);
+  return parts.join("\n\n---\n\n");
+}
+
+function createCrmConnector({ store, fetchImpl = fetch, now = () => new Date() }) {
+  const noteQueues = new Map();
+
+  async function resolvedConfig() {
+    const settings = sanitizeSettings(await store.getSettings());
+    const apiKey = await store.getApiKey();
+    if (!apiKey) throw new CrmError("CRM API key is required", { code: "NOT_CONFIGURED" });
+    return { ...settings, apiKey: String(apiKey) };
+  }
+
+  async function request(path, { method = "GET", body } = {}, capturedConfig = null) {
+    const config = capturedConfig || (await resolvedConfig());
+    const controller = new AbortController();
+    const timer = setTimeout(() => controller.abort(), REQUEST_TIMEOUT_MS);
+    try {
+      let response;
+      try {
+        response = await fetchImpl(`${config.baseUrl}${path}`, {
+          method,
+          headers: {
+            "x-api-key": config.apiKey,
+            ...(body === undefined ? {} : { "content-type": "application/json" }),
+          },
+          body: body === undefined ? undefined : JSON.stringify(body),
+          redirect: "manual",
+          signal: controller.signal,
+        });
+      } catch (error) {
+        if (error?.name === "AbortError")
+          throw new CrmError("CRM request timed out", { code: "TIMEOUT" });
+        throw new CrmError("CRM request failed", { code: "NETWORK_ERROR" });
+      }
+      if (response.status >= 300 && response.status < 400) {
+        throw new CrmError("CRM redirects are not allowed", {
+          code: "REDIRECT_BLOCKED",
+          status: response.status,
+        });
+      }
+      let payload = null;
+      const contentType = response.headers?.get?.("content-type") || "";
+      if (contentType.includes("json")) {
+        try {
+          payload = await response.json();
+        } catch (error) {
+          if (controller.signal.aborted || error?.name === "AbortError") {
+            throw new CrmError("CRM request timed out", { code: "TIMEOUT" });
+          }
+          throw new CrmError("CRM returned an invalid response", {
+            code: "INVALID_RESPONSE",
+            status: response.status,
+          });
+        }
+      }
+      if (!response.ok) {
+        throw new CrmError("CRM request was rejected", {
+          code: typeof payload?.code === "string" ? payload.code : "CRM_ERROR",
+          status: response.status,
+        });
+      }
+      if (!payload || typeof payload !== "object") {
+        throw new CrmError("CRM returned an invalid response", {
+          code: "INVALID_RESPONSE",
+          status: response.status,
+        });
+      }
+      return { payload, config };
+    } finally {
+      clearTimeout(timer);
+    }
+  }
+
+  async function syncOnce(noteId, target) {
+    if (!target || !["contact", "company"].includes(target.type) || !target.id) {
+      throw new CrmError("CRM target is invalid", { code: "INVALID_TARGET" });
+    }
+    const note = await store.getNote(noteId);
+    if (!note || note.deleted_at) throw new CrmError("Note not found", { code: "NOTE_NOT_FOUND" });
+    const config = await resolvedConfig();
+    const timestamp = now();
+    const syncedAt = timestamp.toISOString();
+    const noteDate = parseNoteDate(note.created_at);
+    const occurredAt = Number.isNaN(noteDate.getTime()) ? syncedAt : noteDate.toISOString();
+    const activity = {
+      type: "NOTE",
+      subject: String(note.title || "Untitled Note"),
+      body: buildActivityBody(note, timestamp),
+      occurredAt,
+      ...(target.type === "contact"
+        ? { contactId: String(target.id) }
+        : { companyId: String(target.id) }),
+    };
+    const previous = await store.getSyncState(noteId);
+    const sameScope =
+      previous?.baseUrl === config.baseUrl && previous?.workspaceSlug === config.workspaceSlug;
+    let activityId = sameScope ? previous?.activityId : null;
+    if (activityId) {
+      if (previous.targetId !== String(target.id) || previous.targetType !== target.type) {
+        throw new CrmError("An existing CRM activity cannot be moved to a different target", {
+          code: "TARGET_CHANGED",
+        });
+      }
+      try {
+        const patchBody = {
+          subject: activity.subject,
+          body: activity.body,
+          occurredAt: activity.occurredAt,
+        };
+        const result = await request(
+          `/rest/activities/${encodeURIComponent(activityId)}`,
+          { method: "PATCH", body: patchBody },
+          config
+        );
+        activityId = String(result.payload.id || activityId);
+      } catch (error) {
+        if (!(error.status === 404 && error.code === "NOT_FOUND")) throw error;
+        activityId = null;
+      }
+    }
+    if (!activityId) {
+      const result = await request("/rest/activities", { method: "POST", body: activity }, config);
+      if (!result.payload.id)
+        throw new CrmError("CRM returned an invalid activity", { code: "INVALID_RESPONSE" });
+      activityId = String(result.payload.id);
+    }
+    const currentConfig = await resolvedConfig();
+    if (
+      currentConfig.baseUrl !== config.baseUrl ||
+      currentConfig.workspaceSlug !== config.workspaceSlug ||
+      currentConfig.apiKey !== config.apiKey
+    ) {
+      throw new CrmError("CRM settings changed during sync", { code: "SETTINGS_CHANGED" });
+    }
+    const state = {
+      baseUrl: config.baseUrl,
+      workspaceSlug: config.workspaceSlug,
+      activityId,
+      targetId: String(target.id),
+      targetType: target.type,
+      syncedAt,
+      scopeHash: crypto
+        .createHash("sha256")
+        .update(`${config.baseUrl}\0${config.workspaceSlug}\0${config.apiKey}`)
+        .digest("hex"),
+    };
