+              type="button"
+              onClick={() => setSelected(target)}
+              className={`w-full flex items-center gap-3 px-3 py-2.5 text-left hover:bg-muted/50 ${selected?.id === target.id && selected.type === target.type ? "bg-primary/5 ring-1 ring-inset ring-primary/20" : ""}`}
+            >
+              {target.type === "contact" ? (
+                <Contact className="h-4 w-4 text-primary/70" />
+              ) : (
+                <Building2 className="h-4 w-4 text-primary/70" />
+              )}
+              <span className="min-w-0 flex-1">
+                <span className="block text-sm font-medium truncate">{target.name}</span>
+                <span className="block text-xs text-muted-foreground truncate">
+                  {target.email || target.domain || target.type}
+                </span>
+              </span>
+              <span
+                className={`h-3.5 w-3.5 rounded-full border ${selected?.id === target.id && selected.type === target.type ? "border-primary bg-primary ring-2 ring-primary/15" : "border-border"}`}
+              />
+            </button>
+          ))}
+          {!searching && targets.length === 0 && (
+            <div className="px-3 py-4 text-center text-xs text-muted-foreground">
+              {t("notes.crm.noMatches", { defaultValue: "No matching contacts or companies" })}
+            </div>
+          )}
+        </div>
+
+        {!showCreate ? (
+          <Button variant="outline-flat" size="sm" onClick={() => setShowCreate(true)}>
+            <Plus className="h-3.5 w-3.5" />
+            {t("notes.crm.newContact", { defaultValue: "New contact" })}
+          </Button>
+        ) : (
+          <div className="rounded-lg border border-border/50 p-3 space-y-3">
+            <p className="text-xs text-muted-foreground">
+              {t("notes.crm.confirmCreate", {
+                defaultValue: "Review these details before creating the contact.",
+              })}
+            </p>
+            <div className="grid grid-cols-2 gap-2">
+              <Input
+                value={contact.name}
+                onChange={(e) => setContact((c) => ({ ...c, name: e.target.value }))}
+                placeholder={t("notes.crm.name", { defaultValue: "Name" })}
+              />
+              <Input
+                type="email"
+                value={contact.email}
+                onChange={(e) => setContact((c) => ({ ...c, email: e.target.value }))}
+                placeholder={t("notes.crm.email", { defaultValue: "Email" })}
+              />
+              <Input
+                value={contact.companyName}
+                onChange={(e) => setContact((c) => ({ ...c, companyName: e.target.value }))}
+                placeholder={t("notes.crm.company", { defaultValue: "Company (optional)" })}
+              />
+              <Input
+                value={contact.companyDomain}
+                onChange={(e) => setContact((c) => ({ ...c, companyDomain: e.target.value }))}
+                placeholder={t("notes.crm.domainSuggestion", {
+                  defaultValue: "Company domain (editable suggestion)",
+                })}
+              />
+            </div>
+            <div className="flex justify-end gap-2">
+              <Button variant="ghost" size="sm" onClick={() => setShowCreate(false)}>
+                {t("common.cancel", { defaultValue: "Cancel" })}
+              </Button>
+              <Button
+                size="sm"
+                onClick={() => void createContact()}
+                disabled={creating || !contact.name.trim() || !contact.email.trim()}
+              >
+                {creating && <Loader2 className="h-3.5 w-3.5 animate-spin" />}
+                {t("notes.crm.createContact", { defaultValue: "Create contact" })}
+              </Button>
+            </div>
+          </div>
+        )}
+
+        {error && <p className="text-xs text-destructive">{error}</p>}
+        <DialogFooter>
+          <Button variant="outline" onClick={() => onOpenChange(false)}>
+            {t("common.cancel", { defaultValue: "Cancel" })}
+          </Button>
+          <Button onClick={() => void sync()} disabled={!selected || syncing}>
+            {syncing && <Loader2 className="h-3.5 w-3.5 animate-spin" />}
+            {syncState
+              ? t("notes.crm.update", { defaultValue: "Update CRM note" })
+              : t("notes.crm.sync", { defaultValue: "Sync to CRM" })}
+          </Button>
+        </DialogFooter>
+      </DialogContent>
+    </Dialog>
+  );
+}
