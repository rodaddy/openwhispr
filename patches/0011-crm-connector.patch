+const fs = require("fs/promises");
+const path = require("path");
+const crypto = require("crypto");
+const { app } = require("electron");
+
+class CrmStore {
+  constructor({ databaseManager, environmentManager }) {
+    this.databaseManager = databaseManager;
+    this.environmentManager = environmentManager;
+    this.settingsPath = path.join(app.getPath("userData"), "crm-settings.json");
+    this.writeQueue = Promise.resolve();
+  }
+
+  async getSettings() {
+    try {
+      const value = JSON.parse(await fs.readFile(this.settingsPath, "utf8"));
+      return {
+        baseUrl: typeof value.baseUrl === "string" ? value.baseUrl : "",
+        appUrl: typeof value.appUrl === "string" ? value.appUrl : "",
+        workspaceSlug: typeof value.workspaceSlug === "string" ? value.workspaceSlug : "",
+      };
+    } catch {
+      return { baseUrl: "", appUrl: "", workspaceSlug: "" };
+    }
+  }
+
+  async saveSettings(settings) {
+    this.writeQueue = this.writeQueue
+      .catch(() => {})
+      .then(async () => {
+        await fs.mkdir(path.dirname(this.settingsPath), { recursive: true });
+        const temp = `${this.settingsPath}.tmp`;
+        await fs.writeFile(temp, JSON.stringify(settings, null, 2) + "\n", { mode: 0o600 });
+        await fs.rename(temp, this.settingsPath);
+      });
+    return this.writeQueue;
+  }
+
+  getApiKey() {
+    return this.environmentManager.getCrmApiKey();
+  }
+
+  saveApiKey(key) {
+    return this.environmentManager.saveCrmApiKey(key);
+  }
+
+  getNote(id) {
+    const note = this.databaseManager.getNote(id);
+    if (!note || note.deleted_at) return null;
+    const mappings = Object.fromEntries(
+      (this.databaseManager.getSpeakerMappings?.(id) || []).map((row) => [
+        row.speaker_id,
+        row.display_name || row.speaker_name || row.name,
+      ])
+    );
+    return { ...note, speakerMappings: mappings };
+  }
+
+  async _scope() {
+    const settings = await this.getSettings();
+    const key = (await this.getApiKey()) || "";
+    return crypto
+      .createHash("sha256")
+      .update(`${settings.baseUrl}\0${settings.workspaceSlug}\0${key}`)
+      .digest("hex");
+  }
+
+  async getSyncState(noteId) {
+    const settings = await this.getSettings();
+    const state = this.databaseManager.getCrmSyncState(noteId, await this._scope());
+    return state
+      ? { ...state, baseUrl: settings.baseUrl, workspaceSlug: settings.workspaceSlug }
+      : null;
+  }
+
+  async saveSyncState(noteId, state) {
+    return this.databaseManager.saveCrmSyncState(
+      noteId,
+      state,
+      state.scopeHash || (await this._scope())
+    );
+  }
+}
+
+module.exports = CrmStore;
