+      const settings = sanitizeSettings(await store.getSettings());
+      return {
+        activityId: state.activityId,
+        targetId: state.targetId,
+        targetType: state.targetType,
+        syncedAt: state.syncedAt,
+        url: `${settings.appUrl}/${encodeURIComponent(settings.workspaceSlug)}/${state.targetType === "contact" ? "contacts" : "companies"}/${encodeURIComponent(state.targetId)}`,
+      };
+    },
+  };
+}
+
+module.exports = { buildActivityBody, createCrmConnector, CrmError };
