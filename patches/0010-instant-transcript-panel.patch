-  const voicePillTravelDuration =
+  const voicePillTravelDuration = resolveLiveTranscriptStageDurationMs(
     liveTranscript.open && liveTranscript.entrancePhase === "encapsulate"
       ? LIVE_TRANSCRIPT_ENTRANCE_TIMING.encapsulateMs
-      : LIVE_TRANSCRIPT_ENTRANCE_TIMING.horizontalMs;
+      : LIVE_TRANSCRIPT_ENTRANCE_TIMING.horizontalMs
+  );
   const state = (listeningEntrance.activeState ||
     voiceActivity.activeState ||
     (isPreparing
diff --git a/src/components/dictation/VoiceModePanelCore.tsx b/src/components/dictation/VoiceModePanelCore.tsx
index e68c0810..8827ce95 100644
--- a/src/components/dictation/VoiceModePanelCore.tsx
+++ b/src/components/dictation/VoiceModePanelCore.tsx
@@ -2,6 +2,7 @@ import { useEffect, useRef, type CSSProperties, type ReactNode, type TransitionE
 import {
   LIVE_TRANSCRIPT_ENTRANCE_TIMING,
   LIVE_TRANSCRIPT_SURFACE_LIMITS,
+  resolveLiveTranscriptStageDurationMs,
 } from "../../helpers/voicePillPresentation";
 import { ExpandingPanelShell } from "./ExpandingPanelShell";
 
@@ -96,8 +97,8 @@ export function VoiceModePanelCore({
       data-panel-direction={horizontalDirection}
       style={
         {
-          "--live-transcript-horizontal-duration": `${LIVE_TRANSCRIPT_ENTRANCE_TIMING.horizontalMs}ms`,
