From e347a16b0471dfa5536d5620e72de19d19d33881 Mon Sep 17 00:00:00 2001
From: Rico Rojas <rickrojas@gmail.com>
Date: Tue, 8 Sep 2026 21:36:51 -0400
Subject: [PATCH] perf(dictation): show the live transcript panel whole instead
 of staging its entrance

The panel walked encapsulate, horizontal, controls, prepare, panel, and
content beats with CSS transitions between each, and the pill travelled
into the footer over the same durations. With the window already sized to
the three-line surface before open, the staged build-up was the visible
delay. LIVE_TRANSCRIPT_INSTANT_ENTRANCE puts the panel straight into its
content stage on the first open frame with zero-length stage and travel
transitions. The staged timeline and its tests stay in place behind the
flag.
---
 src/App.jsx                                            | 6 ++++--
 src/components/dictation/AgentDictationPillOverlay.tsx | 6 ++++--
 src/components/dictation/VoiceModePanelCore.tsx        | 5 +++--
 src/helpers/voicePillPresentation.js                   | 9 +++++++++
 src/hooks/useLiveTranscriptPanel.js                    | 8 ++++++++
 5 files changed, 28 insertions(+), 6 deletions(-)

diff --git a/src/App.jsx b/src/App.jsx
index 31f3efc3..9afed9ad 100644
--- a/src/App.jsx
+++ b/src/App.jsx
@@ -26,6 +26,7 @@ import { createMainWindowResizeCoordinator } from "./utils/mainWindowResizeCoord
 import {
   ASSISTANT_FOOTER_TRANSITION_TIMING,
   LIVE_TRANSCRIPT_ENTRANCE_TIMING,
+  resolveLiveTranscriptStageDurationMs,
   resolveLiveTranscriptEntrancePresentation,
   resolveAssistantFooterPresentation,
   resolveAgentModeActive,
@@ -547,10 +548,11 @@ export default function App() {
     panelStartPosition,
     horizontalDirection: voiceHorizontalDirection,
   });
-  const voicePillTravelDuration =
+  const voicePillTravelDuration = resolveLiveTranscriptStageDurationMs(
     liveTranscript.open && liveTranscript.entrancePhase === "encapsulate"
       ? LIVE_TRANSCRIPT_ENTRANCE_TIMING.encapsulateMs
-      : LIVE_TRANSCRIPT_ENTRANCE_TIMING.horizontalMs;
+      : LIVE_TRANSCRIPT_ENTRANCE_TIMING.horizontalMs
+  );
   const dictationErrorSuppressesPill =
     dictationErrorActionCount > 0 || dictationErrorPillHandoffActive;
   // Keep one pill DOM node alive while final Agent actions own the footer. On
diff --git a/src/components/dictation/AgentDictationPillOverlay.tsx b/src/components/dictation/AgentDictationPillOverlay.tsx
