diff --git a/src/helpers/voicePillPresentation.js b/src/helpers/voicePillPresentation.js
index 25881907..3ceb9ac6 100644
--- a/src/helpers/voicePillPresentation.js
+++ b/src/helpers/voicePillPresentation.js
@@ -111,6 +111,15 @@ export const LIVE_TRANSCRIPT_ENTRANCE_TIMING = Object.freeze({
   contentSettleMs: 20,
 });
 
+// Fork: the panel appears in its final shape on the first frame after the
+// native window has been sized, instead of walking the staged entrance above.
+// The timeline stays exported for the staged path and its tests.
+export const LIVE_TRANSCRIPT_INSTANT_ENTRANCE = true;
+
+export function resolveLiveTranscriptStageDurationMs(stagedMs) {
+  return LIVE_TRANSCRIPT_INSTANT_ENTRANCE ? 0 : stagedMs;
+}
+
 export function getLiveTranscriptEntranceTimeline(timing = LIVE_TRANSCRIPT_ENTRANCE_TIMING) {
   const horizontalAtMs = timing.encapsulateMs + timing.encapsulateHoldMs;
   const controlsAtMs = horizontalAtMs + timing.horizontalMs + timing.controlsDelayMs;
diff --git a/src/hooks/useLiveTranscriptPanel.js b/src/hooks/useLiveTranscriptPanel.js
index 9dce93b8..2ce9f7fe 100644
--- a/src/hooks/useLiveTranscriptPanel.js
+++ b/src/hooks/useLiveTranscriptPanel.js
@@ -3,6 +3,7 @@ import { createLatestValueScheduler } from "../utils/latestValueScheduler";
 import {
   getLiveTranscriptEntranceTimeline,
   LIVE_TRANSCRIPT_ENTRANCE_TIMING,
+  LIVE_TRANSCRIPT_INSTANT_ENTRANCE,
   LIVE_TRANSCRIPT_SURFACE_LIMITS,
   shouldOfferLiveTranscriptReopen,
 } from "../helpers/voicePillPresentation";
@@ -237,6 +238,13 @@ export function useLiveTranscriptPanel({
       openFrameRef.current = requestAnimationFrame(() => {
         if (generation !== openGenerationRef.current) return;
         setOpen(true);
+        if (LIVE_TRANSCRIPT_INSTANT_ENTRANCE) {
+          // The window is already at the three-line surface; show the panel
+          // whole and let text flow from the next scheduler tick.
+          setEntrancePhase("content");
+          resumeText();
+          return;
+        }
         const timeline = getLiveTranscriptEntranceTimeline();
         entranceTimersRef.current = [
           setTimeout(() => setEntrancePhase("horizontal"), timeline.horizontalAtMs),
